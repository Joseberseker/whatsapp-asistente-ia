# --- Meta / WhatsApp Cloud API (ver docs/setup-meta.md) ---
WHATSAPP_TOKEN=            # token permanente de System User
WHATSAPP_PHONE_NUMBER_ID=  # ID del número de prueba
WHATSAPP_APP_SECRET=       # App Secret, para validar la firma del webhook
WHATSAPP_VERIFY_TOKEN=     # string que inventas tú y pegas en la config del webhook
WHATSAPP_REMINDER_TEMPLATE=recordatorio
WHATSAPP_TEMPLATE_LANG=es

# --- IA ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemma-4-26b-a4b-it  # en orden, si el principal falla (cuota, saturación, timeout)

# --- App ---
TZ=America/Santiago
DB_PATH=asistente.db
LOG_LEVEL=INFO             # DEBUG muestra el payload completo de cada webhook
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=        # obligatorio: sin él el dashboard rechaza todo
